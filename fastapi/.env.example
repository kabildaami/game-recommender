# The main GameGem project already reads PROJECT_ROOT/.env.
# These are optional API/web-layer overrides that can live there too.
GAMEGEM_HOST=127.0.0.1
GAMEGEM_PORT=8000
GAMEGEM_SESSION_TTL_MINUTES=120
GAMEGEM_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173
