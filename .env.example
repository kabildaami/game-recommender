# Required
GROQ_API_KEY=your_groq_api_key_here

# Low-token classifier / small talk
GROQ_INTENT_MODEL=allam-2-7b
GROQ_GENERAL_MODEL=allam-2-7b

# Grounded recommendation and detail generation
GROQ_RAG_MODEL=qwen/qwen3.8-27b
GROQ_DETAIL_MODEL=qwen/qwen3.8-27b

# Local embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# Retrieval / generation limits
RECOMMENDATION_TOP_K=6
DETAIL_TOP_K=3
INTENT_MAX_TOKENS=2
GENERAL_MAX_TOKENS=140
RAG_MAX_TOKENS=420
DETAIL_MAX_TOKENS=360

# Conversation context sent to Groq. 0 = send all stored history.
MAX_HISTORY_TURNS=8
CLASSIFIER_HISTORY_MESSAGES=2
CLASSIFIER_CONTEXT_CHARS=220
